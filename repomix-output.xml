@PIPELINES.register_module()
class WaymoPointToMultiViewDepthFusion(PointToMultiViewDepth):
    def __call__(self, results):
        points_camego_aug = results['points'].tensor[:, :3]
        # print(points_lidar.shape)
        imgs, rots, trans, intrins = results['img_inputs'][:4]
        post_rots, post_trans, bda = results['img_inputs'][4:]
        device = points_camego_aug.device

        points_camego = points_camego_aug - bda[:3, 3].view(1,3)
        points_camego = points_camego.matmul(torch.inverse(bda[:3,:3]).T)

        depth_map_list = []
        
        # initialize variables to accumulate rgb values per point
        num_points = points_camego.shape[0]
        points_rgb_sum = torch.zeros((num_points, 3), device=device)
        points_rgb_count = torch.zeros(num_points, device=device)
        # initailize uv holder
        points_uv_list = []
        
        for cid in range(len(results['img_filename'])):
            
            cam2camego = results['sensor2ego'][cid]
            cam2camego = torch.from_numpy(cam2camego)

            cam2img = np.eye(4, dtype=np.float32)
            cam2img = torch.from_numpy(cam2img)
            cam2img[:3, :3] = torch.from_numpy(results['cam_intrinsic'][cid])

            camego2img = cam2img.matmul(torch.inverse(cam2camego))

            points_img = points_camego.matmul(
                camego2img[:3, :3].T) + camego2img[:3, 3].unsqueeze(0)
            points_img = torch.cat(
                [points_img[:, :2] / points_img[:, 2:3], points_img[:, 2:3]],
                1)
            points_img = points_img.matmul(
                post_rots[cid].T) + post_trans[cid:cid + 1, :]
            depth_map = self.points2depthmap(points_img, imgs.shape[2],
                                             imgs.shape[3])
            depth_map_list.append(depth_map)
            
            # get rgb values using bilinear interpolation
            indices, rgb_values = self.get_rgb_values(points_img, imgs, cid)
            points_uv_list.append(points_img[:, :2])
            
            # # Accumulate RGB values and counts
            # points_rgb_sum[indices] += rgb_values
            # points_rgb_count[indices] += 1
            # Accumulate RGB values and counts if valid
            if indices.numel() > 0 and rgb_values.numel() > 0:
                if rgb_values.shape[1] == 3:
                    points_rgb_sum[indices] += rgb_values
                    points_rgb_count[indices] += 1
                else:
                    print(f"Unexpected rgb_values shape at camera {cid}: {rgb_values.shape}")
            else:
                # No valid points for this camera
                pass
         # Stack all points_uv column-wise
        points_uv_stacked = torch.cat(points_uv_list, dim=1)  # Stack along columns
            
        # Double-check row consistency
        assert points_uv_stacked.shape[0] == num_points, \
            "Mismatch in number of rows after stacking points_uv!"
        # Compute average RGB values
        points_rgb_avg = points_rgb_sum / points_rgb_count.unsqueeze(-1).clamp(min=1e-6)
        points_rgb_avg[points_rgb_count == 0] = 0  # Handle points not visible in any camera
        # Concatenate RGB values to points
        points_lidar_rgb = torch.cat([results['points'].tensor, points_rgb_avg, points_uv_stacked], dim=1)

        # xyz range intensity rgb uv1 uv2 uv3 uv4 uv5 = total 18 channels

        results['points'].tensor = points_lidar_rgb
        depth_map = torch.stack(depth_map_list)
        results['gt_depth'] = depth_map
        return results


@PIPELINES.register_module()
class ResizeMultiImage(Resize):
    """Resize a list of images, bboxes, and masks directly from the provided 
    img_scale, ignoring any existing scale or scale_factor in results.

    This class extends the Resize class to handle lists of images. It will:
    - Randomly select a scale from the configured img_scale and multiscale_mode.
    - Print the shape of each image before and after resizing.
    """

    def __call__(self, results):
        """Call function to:
        - Directly sample a scale from img_scale.
        - Resize all images, bounding boxes, masks, and segmentation maps.
        """
        # Directly sample the scale from self.img_scale without checking results
        if self.ratio_range is not None:
            # If ratio_range is set, sample a ratio and multiply by img_scale[0].
            scale, scale_idx = self.random_sample_ratio(self.img_scale[0], self.ratio_range)
        elif len(self.img_scale) == 1:
            # If there is only one scale, just use it.
            scale, scale_idx = self.img_scale[0], 0
        elif self.multiscale_mode == 'range':
            # If multiscale_mode is 'range', sample a scale from the given range.
            scale, scale_idx = self.random_sample(self.img_scale)
        elif self.multiscale_mode == 'value':
            # If multiscale_mode is 'value', randomly select one scale from the list.
            scale, scale_idx = self.random_select(self.img_scale)
        else:
            raise NotImplementedError('Unknown multiscale_mode: '
                                      f'{self.multiscale_mode}')

        # Set the chosen scale in results
        results['scale'] = scale

        # Resize images
        self._resize_img(results)

        # Resize bounding boxes if they exist
        if 'bbox_fields' in results:
            self._resize_bboxes(results)

        # Resize masks if they exist
        if 'mask_fields' in results:
            self._resize_masks(results)

        # Resize segmentation maps if they exist
        if 'seg_fields' in results:
            self._resize_seg(results)
                
        return results

    def _resize_img(self, results):
        """Resize a list of images with `results['scale']`."""
        imgs = results['img']
        if isinstance(imgs, list):
            resized_imgs = []
            img_shapes = []
            pad_shapes = []
            scale_factors = []

            for i, img in enumerate(imgs):
                # Process a single image through the parent resize logic
                results_single = {
                    'img': img,
                    'scale': results['scale'],
                    'keep_ratio': self.keep_ratio
                }

                super()._resize_img(results_single)

                resized_imgs.append(results_single['img'])
                img_shapes.append(results_single['img_shape'])
                pad_shapes.append(results_single['pad_shape'])
                scale_factors.append(results_single['scale_factor'])

            results['img'] = resized_imgs
            results['img_shape'] = img_shapes
            results['pad_shape'] = pad_shapes
            results['scale_factor'] = scale_factors
        else:
            # Fallback to single image resizing
            super()._resize_img(results)

@PIPELINES.register_module()
class PadMultiImages(Pad):
    """Pad multiple images, masks, and segmentation maps.

    This class extends the Pad class to handle a list of images in `results['img']`.
    If `results['img']` is a list, all images will be padded to the same dimensions,
    determined by `self.size`, `self.size_divisor`, or `pad_to_square`.

    If `results['img']` is a single image (not a list), it defaults to the original behavior.
    """

    def _pad_img(self, results):
        """Pad images according to `self.size` or `self.size_divisor`."""
        pad_val = self.pad_val.get('img', 0)
        img_fields = results.get('img_fields', ['img'])

        # We assume `img_fields` contains keys for images. By default it's ['img'].
        # If you have multiple image fields, adjust accordingly.
        for key in img_fields:
            imgs = results[key]
            # If it's just a single image, fallback to original Pad behavior
            if not isinstance(imgs, list):
                if self.pad_to_square:
                    max_size = max(imgs.shape[:2])
                    self.size = (max_size, max_size)
                if self.size is not None:
                    padded_img = mmcv.impad(imgs, shape=self.size, pad_val=pad_val)
                else:
                    # self.size_divisor is not None at this point
                    padded_img = mmcv.impad_to_multiple(imgs, self.size_divisor, pad_val=pad_val)

                results[key] = padded_img
                results['pad_shape'] = padded_img.shape
                results['pad_fixed_size'] = self.size
                results['pad_size_divisor'] = self.size_divisor
            else:
                if self.pad_to_square:
                    # Find max dimension among all images
                    max_dim = max(max(img.shape[:2]) for img in imgs)
                    self.size = (max_dim, max_dim)
                    pad_shape = self.size
                else:
                    if self.size is not None:
                        # Fixed size provided
                        pad_shape = self.size
                    else:
                        # size_divisor is not None
                        # Compute the largest height and width
                        max_h = max(img.shape[0] for img in imgs)
                        max_w = max(img.shape[1] for img in imgs)
                        # Find the multiples
                        pad_h = int(np.ceil(max_h / self.size_divisor) * self.size_divisor)
                        pad_w = int(np.ceil(max_w / self.size_divisor) * self.size_divisor)
                        pad_shape = (pad_h, pad_w)

                padded_imgs = []
                for i, img in enumerate(imgs):
                    if self.size is not None:
                        padded_img = mmcv.impad(img, shape=pad_shape, pad_val=pad_val)
                    else:
                        padded_img = mmcv.impad(img, shape=pad_shape, pad_val=pad_val)
                    padded_imgs.append(padded_img)

                results[key] = padded_imgs
                results['pad_shape'] = padded_imgs[0].shape
                results['pad_fixed_size'] = self.size
                results['pad_size_divisor'] = self.size_divisor


    def __call__(self, results):
        """Call function to pad images, masks, semantic segmentation maps."""
        self._pad_img(results)
        self._pad_masks(results)
        self._pad_seg(results)
        return results

@PIPELINES.register_module()
class NormalizeMultiImage(Normalize):
    """Normalize multiple images, extending the original Normalize class.

    This class extends the Normalize class to handle a list of images in `results['img']`.
    If `results['img']` is a list, all images in the list will be normalized 
    using the provided mean, std, and to_rgb parameters.
    """

    def __call__(self, results):
        """Call function to normalize images (single or multiple).

        Args:
            results (dict): Result dict from loading pipeline.

        Returns:
            dict: Normalized results, 'img_norm_cfg' key is added into result dict.
        """
        img_fields = results.get('img_fields', ['img'])
        for key in img_fields:
            imgs = results[key]
            if isinstance(imgs, list):
                # Multiple images case
                normalized_imgs = []
                for i, img in enumerate(imgs):
                    norm_img = mmcv.imnormalize(img, self.mean, self.std, self.to_rgb)
                    normalized_imgs.append(norm_img)
                results[key] = normalized_imgs
            else:
                # Single image case, fallback to original behavior
                results[key] = mmcv.imnormalize(imgs, self.mean, self.std, self.to_rgb)

        results['img_norm_cfg'] = dict(
            mean=self.mean, std=self.std, to_rgb=self.to_rgb)
        return results

@PIPELINES.register_module()
class RandomAugMultiViewImage(object):
    """
    Randomly augment multi-view images and format metadata correctly
    by creating lists for each metadata item, similar to the default
    mmdetection3d pipelines.
    """

    def __init__(self, data_config, is_train=True):
        self.data_config = data_config
        self.is_train = is_train

    def img_transform(self, img, resize_dims, crop, flip, rotate):
        """Applies a series of PIL transformations."""
        img = img.resize(resize_dims, resample=Image.NEAREST)
        img = img.crop(crop)
        if flip:
            img = img.transpose(method=Image.FLIP_LEFT_RIGHT)
        img = img.rotate(rotate)
        return img

    def sample_augmentation(self, H, W):
        """Samples augmentation parameters."""
        fH, fW = self.data_config['input_size']
        if self.is_train:
            resize = float(fW) / float(W)
            resize += np.random.uniform(*self.data_config['resize'])
            resize_dims = (int(W * resize), int(H * resize))
            newW, newH = resize_dims
            crop_h = int((1 - np.random.uniform(*self.data_config['crop_h'])) * newH) - fH
            crop_w = int(np.random.uniform(0, max(0, newW - fW)))
            crop = (crop_w, crop_h, crop_w + fW, crop_h + fH)
            flip = self.data_config['flip'] and np.random.choice([0, 1])
            rotate = np.random.uniform(*self.data_config['rot'])
        else: # Test-time
            resize = float(fW) / float(W)
            resize += self.data_config.get('resize_test', 0.0)
            resize_dims = (int(W * resize), int(H * resize))
            newW, newH = resize_dims
            crop_h = int((1 - np.mean(self.data_config['crop_h'])) * newH) - fH
            crop_w = int(max(0, newW - fW) / 2)
            crop = (crop_w, crop_h, crop_w + fW, crop_h + fH)
            flip = False
            rotate = 0
        return resize, resize_dims, crop, flip, rotate

    def __call__(self, results):
        imgs = results['img']
        num_views = len(imgs)
        H, W = results['ori_shape'][:2]

        # Sample one set of augmentation parameters to be applied to all views
        resize, resize_dims, crop, flip, rotate = self.sample_augmentation(H, W)

        # --- START OF THE CORRECT IMPLEMENTATION ---
        
        # Initialize empty lists to store metadata for each view
        aug_imgs = []
        img_shapes = []
        scale_factors = []

        # This is the final shape of each image after cropping
        post_aug_shape = (crop[3] - crop[1], crop[2] - crop[0], 3)
        
        # This is the scale factor applied
        scale_factor_wh = [resize, resize]

        # Loop through each image to apply transforms and build the metadata lists
        for img in imgs:
            img_pil = Image.fromarray(img)
            aug_img = self.img_transform(
                img_pil,
                resize_dims=resize_dims,
                crop=crop,
                flip=flip,
                rotate=rotate
            )
            aug_imgs.append(np.array(aug_img))
            
            # Use .append() to build the lists, ensuring the correct structure
            img_shapes.append(post_aug_shape)
            scale_factors.append(scale_factor_wh)

        # Update the results dictionary with the correctly formatted lists
        results['img'] = aug_imgs
        results['img_shape'] = img_shapes
        results['scale_factor'] = scale_factors
        
        # These values are shared across all images
        results['flip'] = flip
        results['rotate'] = rotate
        results['img_crop_offset'] = np.array([crop[0], crop[1]], dtype=np.float32)

        # --- END OF THE CORRECT IMPLEMENTATION ---

        return results
